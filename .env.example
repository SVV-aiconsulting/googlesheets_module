# Скопируйте этот файл в .env и подставьте свои значения:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS / Linux)

# Путь к JSON-ключу service account (относительно корня проекта)
GOOGLE_CREDENTIALS_PATH=credentials/vibecode-508812-3d0fc1f895b3.json

# Email service account — этим адресом нужно расшарить таблицу/папку (права редактора)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com

# ID Google-таблицы из URL:
#   https://docs.google.com/spreadsheets/d/ВОТ_ЭТОТ_ID/edit
GOOGLE_SPREADSHEET_ID=YOUR_SPREADSHEET_ID

# ID рабочей папки Drive (из URL папки). Нужен, чтобы:
#   - показывать только файлы внутри этой папки;
#   - создавать Docs/Sheets именно туда (create_google_document / spreadsheet).
# Как взять: откройте папку → скопируйте ID после /folders/
#   https://drive.google.com/drive/folders/ВОТ_ЭТОТ_ID
# Пусто = список всего доступного аккаунту.
GOOGLE_DRIVE_FOLDER_ID=

# OAuth2 (личный аккаунт пользователя) — Desktop client secret из Google Cloud Console
GOOGLE_OAUTH_CLIENT_SECRET_PATH=credentials/client_secret_YOUR.apps.googleusercontent.com.json
# Куда сохранять токен после первого входа в браузере
GOOGLE_OAUTH_TOKEN_PATH=credentials/token.json

# Путь к SQLite-базе мини-CRM (по умолчанию data/crm.db)
CRM_DB_PATH=data/crm.db

# URL локального FastAPI для Tkinter-клиента
CRM_API_URL=http://127.0.0.1:8000
